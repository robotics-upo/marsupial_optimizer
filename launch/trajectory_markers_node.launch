<launch>
    <!-- Params -->
	<arg name="path" default="$(find marsupial_optimizer)/cfg/optimized_path"/>
    <arg name="name_file_trajectory" default="maspa"/>
    <arg name="rviz"    default="true"/> 
    <arg name="viz_file"    default="trajectory_marker"/>
    <arg name="map"    default="comparative"/>
    <arg name="ugv_base_frame"    default="ugv_base_link"/> #position reel on UGV
    <arg name="uav_base_frame"    default="uav_base_link"/> #position reel on UAVn
    <arg name="num_pos_initial"    default="1"/> 
    <arg name="pos_uav_above_ugv"    default="1.0"/> 
    <arg name="pos_reel_x"    default="0.0"/> #position reel on UGV 
    <arg name="pos_reel_y"    default="0.0"/> #position reel on UGV
    <arg name="pos_reel_z"    default="0.38"/> #position reel on UGV


    <!-- Main nodo for plot Markers and save information-->
	<node pkg="marsupial_optimizer" type="trajectory_markers_node" name="trajectory_markers_node" output="screen"># launch-prefix="gdb -ex run --args">
        <rosparam command="load" file="$(find marsupial_optimizer)/cfg/$(arg map)_ws.yaml"/>
		<param name="path"                  value="$(arg path)"/>
		<param name="name_file_trajectory"  value="$(arg name_file_trajectory)"/>
        <!-- For Grid3D -->
        <param name="map_path"                  value="$(find marsupial_optimizer)/maps/$(arg map).bt"/>
        <param name="global_frame_id"           value="map"/>
	</node>

    <!-- Launch Octomap of Scenario -->
    <include file="$(find marsupial_optimizer)/launch/octomap_server.launch">
        <arg name="map_file"  value="$(arg map)"/>    
    </include>
        <include file="$(find marsupial_optimizer)/launch/octomap_server.launch">
        <arg name="map_file"  value="$(arg map)_obstacles"/>    
        <arg name="node_name"  value="octomap_server_obstacles"/>  
        <arg name="published_pc"  value="/region_growing_obstacles_pc_map"/>   
    </include>
    <include file="$(find marsupial_optimizer)/launch/octomap_server.launch">
        <arg name="map_file"  value="$(arg map)_traversability"/>   
        <arg name="node_name"  value="octomap_server_traversability"/>   
        <arg name="published_pc"  value="/region_growing_traversability_pc_map"/>   
    </include>

      <!-- Publishing UGV and UAV tf -->
    <node pkg="marsupial_optimizer" type="optimizer_publisher_tf_node" name="optimizer_publisher_tf_node" output="screen">
        <rosparam command="load" file="$(find marsupial_optimizer)/cfg/$(arg map).yaml" />
        <param name="num_pos_initial" value="$(arg num_pos_initial)"/>
        <param name="pos_uav_above_ugv" value="$(arg pos_uav_above_ugv)"/>
        <param name="uav_base_frame" value="$(arg uav_base_frame)"/>
        <param name="ugv_base_frame" value="$(arg ugv_base_frame)"/>
        <param name="reel_base_frame" value="reel_base_link"/>
    </node>

    <!-- Publishing static tf -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="map_tf_node" args="0 0 0 0 0 0 1 /world /map"/> # x y z y p r
    <node pkg="tf2_ros" type="static_transform_publisher" name="reel_base_link_tf_node" args="$(arg pos_reel_x) $(arg pos_reel_y) $(arg pos_reel_z) -0.0 0.0 0.0  ugv_base_link reel_base_link"/> # x y z y p r

    <node pkg="rviz" name="rviz" type="rviz" args="-d $(find marsupial_optimizer)/viz/$(arg viz_file).rviz" if="$(arg rviz)"/>
    
    <!-- UGV Marker -->
    <node pkg="upo_markers" type="siar_marker_node" name="siar_marker_node" output="screen">
        <param name="frame_id" value="$(arg ugv_base_frame)"/>
        <param name="scale" value="2.0"/>
    </node>

     <!-- UAV Marker -->
    <node pkg="upo_markers" type="marker_node" name="uav_marker_node" output="screen">
        <param name="base_frame_id" value="$(arg uav_base_frame)"/>
        <param name="model" value="m100"/> <!-- m600 or m100 -->
        <param name="color" value="0.0"/> 
        <param name="color_r" value="0.0"/> 
        <param name="color_g" value="0.0"/> 
        <param name="color_b" value="0.0"/> 
        <param name="scale" value="1.5"/>
    </node>

</launch>